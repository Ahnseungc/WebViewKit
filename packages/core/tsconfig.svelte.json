{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "@sveltejs/kit"],
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": [
    "src/svelte/**/*.ts",
    "src/svelte/**/*.svelte",
    "src/sveltekit/**/*.ts",
    "src/sveltekit/**/*.svelte"
  ],
  "exclude": []
}
