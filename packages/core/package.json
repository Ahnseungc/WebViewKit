{
  "name": "@ahnseungchan/webviewkit",
  "version": "2.4.0",
  "description": "Stack navigation and native WebView bridge (RN/Flutter) for React hybrid apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "jest --config jest.config.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "webview",
    "navigation",
    "stack-router",
    "react",
    "mobile",
    "router",
    "react-native-webview"
  ],
  "author": "Seungchan Ahn <omnipoo@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahnseungc/WebViewKit.git"
  },
  "bugs": {
    "url": "https://github.com/Ahnseungc/WebViewKit/issues"
  },
  "homepage": "https://github.com/Ahnseungc/WebViewKit#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.11.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "tsup": "8.3.5",
    "typescript": "^5.3.3"
  }
}
