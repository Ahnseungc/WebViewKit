{
  "name": "@ahnseungchan/webviewkit",
  "version": "2.6.0",
  "description": "Native-like stack navigation (iOS-style push/back, keep-alive, deep links) and a React Native / Flutter bridge for WebView apps. React, Vue 3, Svelte 5, or a framework-agnostic core.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": {
        "import": "./dist/core.d.mts",
        "require": "./dist/core.d.ts"
      },
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./vue": {
      "types": {
        "import": "./dist/vue.d.mts",
        "require": "./dist/vue.d.ts"
      },
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./react-router": {
      "types": {
        "import": "./dist/react-router.d.mts",
        "require": "./dist/react-router.d.ts"
      },
      "import": "./dist/react-router.mjs",
      "require": "./dist/react-router.js"
    },
    "./next": {
      "types": {
        "import": "./dist/next.d.mts",
        "require": "./dist/next.d.ts"
      },
      "import": "./dist/next.mjs",
      "require": "./dist/next.js"
    },
    "./vue-router": {
      "types": {
        "import": "./dist/vue-router.d.mts",
        "require": "./dist/vue-router.d.ts"
      },
      "import": "./dist/vue-router.mjs",
      "require": "./dist/vue-router.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "svelte": "./dist/sveltekit/index.js",
      "default": "./dist/sveltekit/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node scripts/build-svelte.mjs",
    "test": "jest --config jest.config.js && vitest run --config vitest.config.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "webview",
    "navigation",
    "stack-router",
    "react",
    "mobile",
    "router",
    "react-native-webview",
    "hybrid-app",
    "webview-navigation",
    "flutter",
    "flutter-inappwebview",
    "ios-transition",
    "page-transition",
    "keep-alive",
    "nextjs",
    "vue",
    "framework-agnostic",
    "svelte",
    "vue3",
    "svelte5",
    "sveltekit",
    "vanilla-js",
    "hybrid",
    "spa-router",
    "native-transition",
    "ssr",
    "react-router",
    "nuxt",
    "vue-router"
  ],
  "author": "Seungchan Ahn <omnipoo@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahnseungc/webview-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Ahnseungc/webview-kit/issues"
  },
  "homepage": "https://github.com/Ahnseungc/webview-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.12.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router": ">=7.0.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.3.0",
    "next": ">=16.0.0",
    "vue-router": ">=4.1.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/svelte": "5.2.6",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vue/test-utils": "2.4.6",
    "esbuild": "0.24.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "25.0.1",
    "next": "16.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7",
    "rimraf": "^5.0.5",
    "svelte": "5.16.0",
    "svelte-check": "4.1.4",
    "ts-jest": "^29.1.2",
    "tsup": "8.3.5",
    "typescript": "^5.3.3",
    "vite": "6.0.7",
    "vitest": "3.0.5",
    "vue": "3.5.13",
    "vue-router": "4.6.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    }
  }
}
